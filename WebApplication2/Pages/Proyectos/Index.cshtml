@page
@model WebApplication2.Pages.Proyectos.IndexModel
@{
    ViewData["Title"] = "Proyectos";
}

<div class="encabezado">
    <h1>Proyectos</h1>
    <p class="mb-0">Listado de proyectos registrados</p>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-page="Create" class="btn btn-verde">Nuevo proyecto</a>

    <form method="get" asp-page="Details" class="d-flex gap-2">
        <input type="text" name="id" class="form-control" style="max-width: 360px"
               placeholder="Buscar por ID de proyecto" />
        <button type="submit" class="btn btn-outline-verde">Buscar</button>
    </form>
</div>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

@if (Model.Proyectos.Count == 0 && Model.MensajeError is null)
{
    <p>No hay proyectos registrados.</p>
}
else
{
    <table class="table table-striped table-hover tabla-datos">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Jefe</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Proyectos)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Descripcion</td>
                    <td>@p.Estado</td>
                    <td>@p.JefeNombre</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-verde">Ver jefe</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
