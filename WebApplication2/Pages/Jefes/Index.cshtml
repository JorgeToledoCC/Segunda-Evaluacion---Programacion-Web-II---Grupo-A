@page
@model WebApplication2.Pages.Jefes.IndexModel
@{
    ViewData["Title"] = "Jefes";
}

<div class="encabezado">
    <h1>Jefes</h1>
    <p class="mb-0">Listado de jefes registrados</p>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<p><a asp-page="Create" class="btn btn-verde">Nuevo jefe</a></p>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

@if (Model.Jefes.Count == 0 && Model.MensajeError is null)
{
    <p>No hay jefes registrados.</p>
}
else
{
    <table class="table table-striped table-hover tabla-datos">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Correo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var j in Model.Jefes)
            {
                <tr>
                    <td>@j.Nombre</td>
                    <td>@j.Cargo</td>
                    <td>@j.Correo</td>
                </tr>
            }
        </tbody>
    </table>
}
